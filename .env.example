DB_PASSWORD=change-me-use-a-strong-password     # required — used by docker-compose for postgres
DATABASE_URL=postgresql+asyncpg://postgres:change-me-use-a-strong-password@localhost:5432/droneyardscanner
KINDWISE_API_KEY=                          # from https://plant.id — app runs in stub mode without it
TELLO_HOST=192.168.10.1                    # default Tello IP when connected to its WiFi
PHOTO_DIR=photos                           # relative or absolute path for saved photos
CORS_ORIGINS=["http://localhost:5173"]     # add your tunnel URL here for phone access
